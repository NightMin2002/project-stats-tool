@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

echo.
echo ╔════════════════════════════════════════════════════════╗
echo ║           📊 项目统计工具 v2.9.1                      ║
echo ║           ✨ 支持历史趋势分析                         ║
echo ╚════════════════════════════════════════════════════════╝
echo.

REM 检查是否有拖放的文件夹参数
if "%~1"=="" (
    echo 💡 使用方法:
    echo    1. 直接双击运行 - 统计当前目录
    echo    2. 拖放项目文件夹到此批处理文件 - 统计指定项目
    echo.
    echo 📈 新功能提示:
    echo    • 每次运行自动保存历史记录
    echo    • 自动对比上次统计结果
    echo    • HTML报告包含历史趋势图
    echo    • 使用 查看历史.bat 查看完整历史
    echo.
    echo ════════════════════════════════════════════════════════
    echo 📂 正在统计当前目录...
    echo.
    node "%~dp0src\project-stats.js"
) else (
    echo 📂 正在统计项目: %~1
    echo.
    echo 📈 功能说明:
    echo    • 自动保存本次统计到历史记录
    echo    • 自动与上次统计对比
    echo    • 生成包含趋势图的HTML可视化报告
    echo.
    echo ════════════════════════════════════════════════════════
    echo.
    node "%~dp0src\project-stats.js" "%~1"
)

echo.
echo ════════════════════════════════════════════════════════
echo.
echo 💡 下一步操作:
echo    1. 打开 results\最新\可视化报告.html 查看完整报告
echo    2. 运行 查看历史.bat 查看历史记录
echo    3. 再次运行本工具以积累更多历史数据
echo.
echo ════════════════════════════════════════════════════════
echo 按任意键退出...
pause >nul